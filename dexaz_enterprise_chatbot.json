        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.phoneNumber }}\",\n  \"type\": \"interactive\",\n  \"interactive\": {\n    \"type\": \"button\",\n    \"header\": { \"type\": \"text\", \"text\": \"Welcome to DEXAZ Academy 🎓\" },\n    \"body\": { \"text\": \"Hi {{ $json.customerName }}! I'm *Nova*, your personal learning assistant at DEXAZ.\\n\\nI'm here 24/7 to help you with courses, payments, schedules, and more. What brings you here today?\" },\n    \"footer\": { \"text\": \"DEXAZ — Elevate Your Learning\" },\n    \"action\": {\n      \"buttons\": [\n        { \"type\": \"reply\", \"reply\": { \"id\": \"explore_courses\", \"title\": \"📚 Explore Courses\" } },\n        { \"type\": \"reply\", \"reply\": { \"id\": \"already_enrolled\", \"title\": \"✅ I'm Enrolled\" } },\n        { \"type\": \"reply\", \"reply\": { \"id\": \"talk_to_human\", \"title\": \"🙋 Talk to Someone\" } }\n      ]\n    }\n  }\n}"
      },
      "id": "n9",
      "name": "🎉 Welcome Experience",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1440, 160]
