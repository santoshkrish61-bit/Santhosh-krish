        "body": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $vars.AGENT_WHATSAPP_NUMBER }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"🚨 *DEXAZ — Live Escalation Alert*\\n\\n*Student:* {{ $json.customerName }}\\n*Phone:* +{{ $json.phoneNumber }}\\n*Loyalty Tier:* {{ $json.loyaltyTier }}\\n*Enrolled In:* {{ $json.enrolledCourses }}\\n*Emotion:* {{ $json.emotion }}\\n*Churn Risk:* {{ $json.churnRisk }}\\n\\n*Their Message:*\\n{{ $json.rawText }}\\n\\n*Nova's Note:*\\n{{ $json.internalNote }}\\n\\n━━━━━━━━━━━━━━━\\nReply directly to +{{ $json.phoneNumber }} on WhatsApp\"\n  }\n}"
