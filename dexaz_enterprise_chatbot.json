            { "id": "p2", "name": "rawText", "value": "={{ $json.entry[0].changes[0].value.messages[0].text?.body ?? $json.entry[0].changes[0].value.messages[0].button?.text ?? $json.entry[0].changes[0].value.messages[0].interactive?.button_reply?.title ?? '' }}", "type": "string" },
